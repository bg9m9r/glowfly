# Normalize line endings in the repository; check out with the platform default.
* text=auto
*.png binary
# Text snapshots are compared byte for byte (after CRLF is folded); keep them LF everywhere.
crates/glowfly-app/tests/snapshots/*.txt text eol=lf
*.sh text eol=lf
*.sublime-syntax text eol=lf
crates/glowfly-core/src/init_ops/** text eol=lf
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
# The packaged desktop entries are compared byte for byte with what Glowfly writes.
packaging/linux/*.desktop text eol=lf
packaging/flatpak/*.desktop text eol=lf
# The package-format markers are read as text; keep them LF everywhere.
packaging/linux/package-format.* text eol=lf
# Fuzz seeds are byte-exact inputs (mixed line endings, NUL bytes): never converted.
fuzz/seeds/** binary
