/target
# egui_kittest working files (approved images are the plain .png)
*.new.png
*.old.png
*.diff.png
# Text snapshot working files (approved text is the plain .txt)
crates/glowfly-app/tests/snapshots/*.new.txt
crates/glowfly-app/tests/snapshots/*.diff.txt

# Local scratch files and AI assistant notes (kept by each developer, not shared)
/temp/
/.claude/
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md

# WiX extensions scripts/package-windows.ps1 fetches
/.wix/

# The Flatpak build's vendored crates and generated files (scripts/package-flatpak.sh)
/vendor/
/packaging/flatpak/generated/
/.flatpak-builder/
