{
    "version": "@VERSION@",
    "description": "Native Git client",
    "homepage": "https://github.com/@REPO@",
    "license": "MIT|Apache-2.0",
    "notes": "Update Glowfly with 'scoop update glowfly' rather than from the app, so Scoop keeps track of its version.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/@REPO@/releases/download/@TAG@/glowfly-@TAG@-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA256_WIN_X64_ZIP@",
            "extract_dir": "glowfly-@TAG@-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/@REPO@/releases/download/@TAG@/glowfly-@TAG@-aarch64-pc-windows-msvc.zip",
            "hash": "@SHA256_WIN_ARM64_ZIP@",
            "extract_dir": "glowfly-@TAG@-aarch64-pc-windows-msvc"
        }
    },
    "bin": "glowfly.exe",
    "shortcuts": [
        [
            "glowfly.exe",
            "Glowfly"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/@REPO@/releases/download/v$version/glowfly-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "glowfly-v$version-x86_64-pc-windows-msvc"
            },
            "arm64": {
                "url": "https://github.com/@REPO@/releases/download/v$version/glowfly-v$version-aarch64-pc-windows-msvc.zip",
                "extract_dir": "glowfly-v$version-aarch64-pc-windows-msvc"
            }
        },
        "hash": {
            "url": "https://github.com/@REPO@/releases/download/v$version/SHA256SUMS",
            "regex": "$sha256\\s+\\*?$basename"
        }
    }
}
