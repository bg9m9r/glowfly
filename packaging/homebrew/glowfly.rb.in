cask "glowfly" do
  arch arm: "aarch64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA256_MAC_ARM64@",
         intel: "@SHA256_MAC_X86_64@"

  url "https://github.com/@REPO@/releases/download/v#{version}/glowfly-v#{version}-#{arch}-apple-darwin.dmg"
  name "Glowfly"
  desc "Native Git client"
  homepage "https://github.com/@REPO@"

  livecheck do
    url :url
    strategy :github_latest
  end

  # Glowfly checks for and installs its own updates.
  auto_updates true
  depends_on macos: ">= :big_sur"

  app "Glowfly.app"

  zap trash: [
    "~/Library/Application Support/Glowfly",
    "~/Library/Caches/Glowfly",
    "~/Library/Logs/Glowfly",
  ]

  caveats <<~EOS
    Glowfly isn't signed or notarized by Apple yet, so macOS stops it the first time it opens.
    On macOS 15 and later, open Glowfly once and close the message, then go to
    System Settings > Privacy & Security and click "Open Anyway" next to the note about Glowfly.
    Or remove the quarantine mark in Terminal:
      xattr -dr com.apple.quarantine #{appdir}/Glowfly.app
    On macOS 14 and earlier, Control-click Glowfly in Applications and choose Open.
  EOS
end
