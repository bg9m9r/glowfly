<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer (WiX 5). A per-user install, without administrator rights, into
  %LOCALAPPDATA%\Programs\Trellis, with a Start menu shortcut, "Open in Trellis" on folders and
  the trellis:// scheme in HKEY_CURRENT_USER.

  Built by scripts/package-windows.ps1:
    wix build -arch x64 -d Version=0.2.0 -d BinDir=<folder of trellis.exe> -d SourceDir=<repository>
      -d AssetsDir=<repository>\assets\icon [-d HasChangelog=1] -o trellis.msi trellis.wxs

  The scheme's values must match what url_scheme::windows writes (a core test checks the
  commands), so Preferences > General shows this copy as registered.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Trellis" Manufacturer="Trellis contributors" Version="$(var.Version)" UpgradeCode="cd5d11a3-a0e0-4c62-9de1-5b1ad7e200d1" Scope="perUser" Compressed="yes" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Trellis is already installed. Uninstall it first to install this one." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="TrellisIcon" SourceFile="$(var.AssetsDir)\trellis.ico" />
    <Property Id="ARPPRODUCTICON" Value="TrellisIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/bg9m9r/trellis" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bg9m9r/trellis/issues" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Trellis" />
      </Directory>
    </StandardDirectory>

    <!-- Per-user components keep their key path in HKCU (ICE38), and remove the folders they made. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="TrellisExe">
        <File Id="TrellisExeFile" Source="$(var.BinDir)\trellis.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="program" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
      <Component Id="Docs">
        <File Id="LicenseMit" Source="$(var.SourceDir)\LICENSE-MIT" KeyPath="no" />
        <File Id="LicenseApache" Source="$(var.SourceDir)\LICENSE-APACHE" KeyPath="no" />
        <File Id="Readme" Source="$(var.SourceDir)\README.md" KeyPath="no" />
        <File Id="Notices" Source="$(var.SourceDir)\THIRD-PARTY-NOTICES.md" KeyPath="no" />
        <?ifdef HasChangelog ?>
        <File Id="Changelog" Source="$(var.SourceDir)\CHANGELOG.md" KeyPath="no" />
        <?endif ?>
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="docs" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- "Open in Trellis" on a folder and on a folder's background (Windows 11: Show more options). -->
      <Component Id="FolderMenu">
        <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Trellis">
          <RegistryValue Type="string" Value="Open in Trellis" />
          <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]trellis.exe,0" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe" "%V"' />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Trellis">
          <RegistryValue Type="string" Value="Open in Trellis" />
          <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]trellis.exe,0" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe" "%V"' />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="folders" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- trellis:// links, as url_scheme::windows registers them. -->
      <Component Id="LinkScheme">
        <RegistryKey Root="HKCU" Key="Software\Classes\trellis">
          <RegistryValue Type="string" Value="URL:Trellis link" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe",0' />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe" "%1"' />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="links" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="TrellisShortcut" Name="Trellis" Description="A Git client" Target="[INSTALLFOLDER]trellis.exe" WorkingDirectory="INSTALLFOLDER" Icon="TrellisIcon" />
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Trellis" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
