<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer (WiX 5). A per-user install, without administrator rights, into
  %LOCALAPPDATA%\Programs\Trellis, with a Start menu shortcut and, as the Options page chooses,
  a desktop shortcut, "Open in Trellis" on folders and the trellis:// scheme in
  HKEY_CURRENT_USER. Its pages: Welcome, License, Options, Ready, progress, then Finish with
  "Launch Trellis".

  The folder is fixed: Trellis tells an installed copy from a portable one by its path
  (app_update::install_kind_for).

  Built by scripts/package-windows.ps1:
    wix build -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext -d Version=0.2.0
      -d BinDir=<folder of trellis.exe> -d SourceDir=<repository> -d AssetsDir=<repository>\assets
      -d LicenseRtf=<license.rtf> [-d HasChangelog=1] -o trellis.msi trellis.wxs pages.wxs

  The scheme's values must match what url_scheme::windows writes (a core test checks the
  commands), so Preferences > General shows this copy as registered.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Trellis" Manufacturer="Trellis contributors" Version="$(var.Version)" UpgradeCode="cd5d11a3-a0e0-4c62-9de1-5b1ad7e200d1" Scope="perUser" Compressed="yes" Language="1033">
    <!-- Same-version upgrades let a rebuilt copy replace the installed one instead of joining it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Trellis is already installed. Uninstall it first to install this one." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="TrellisIcon" SourceFile="$(var.AssetsDir)\icon\trellis.ico" />
    <Property Id="ARPPRODUCTICON" Value="TrellisIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/bg9m9r/trellis" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bg9m9r/trellis/issues" />
    <!-- Settings > Apps offers Uninstall only; there is nothing to modify. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- The Options page's choices, all on for a first install. An upgrade starts from what the
         installed copy chose: each choice's component leaves a value under
         HKCU\Software\Trellis\Installer, and a missing value turns the choice off. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" />
    <Property Id="FOLDERMENU" Value="1" />
    <Property Id="LINKSCHEME" Value="1" />
    <Property Id="HAD_DESKTOP">
      <RegistrySearch Root="HKCU" Key="Software\Trellis\Installer" Name="desktop" Type="raw" />
    </Property>
    <Property Id="HAD_FOLDERS">
      <RegistrySearch Root="HKCU" Key="Software\Trellis\Installer" Name="folders" Type="raw" />
    </Property>
    <Property Id="HAD_LINKS">
      <RegistrySearch Root="HKCU" Key="Software\Trellis\Installer" Name="links" Type="raw" />
    </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Value="{}" After="AppSearch" Sequence="first" Condition="WIX_UPGRADE_DETECTED AND NOT HAD_DESKTOP" />
    <SetProperty Id="FOLDERMENU" Value="{}" After="AppSearch" Sequence="first" Condition="WIX_UPGRADE_DETECTED AND NOT HAD_FOLDERS" />
    <SetProperty Id="LINKSCHEME" Value="{}" After="AppSearch" Sequence="first" Condition="WIX_UPGRADE_DETECTED AND NOT HAD_LINKS" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Trellis" />
      </Directory>
    </StandardDirectory>

    <!-- Per-user components keep their key path in HKCU (ICE38), and remove the folders they made.
         WiX can't generate the GUID of a component with files and a registry key path, so the
         two with files have fixed ones; never reuse them for different contents. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="TrellisExe" Guid="05533b4e-6786-48ab-a4e3-d079585ec1ab">
        <File Id="TrellisExeFile" Source="$(var.BinDir)\trellis.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="program" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
      <Component Id="Docs" Guid="f73caab7-c1ea-4ccc-ab20-98922f5a2563">
        <File Id="LicenseMit" Source="$(var.SourceDir)\LICENSE-MIT" KeyPath="no" />
        <File Id="LicenseApache" Source="$(var.SourceDir)\LICENSE-APACHE" KeyPath="no" />
        <File Id="Readme" Source="$(var.SourceDir)\README.md" KeyPath="no" />
        <File Id="Notices" Source="$(var.SourceDir)\THIRD-PARTY-NOTICES.md" KeyPath="no" />
        <?ifdef HasChangelog ?>
        <File Id="Changelog" Source="$(var.SourceDir)\CHANGELOG.md" KeyPath="no" />
        <?endif ?>
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="docs" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- "Open in Trellis" on a folder and on a folder's background (Windows 11: Show more options). -->
      <Component Id="FolderMenu" Condition="FOLDERMENU = 1">
        <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Trellis">
          <RegistryValue Type="string" Value="Open in Trellis" />
          <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]trellis.exe,0" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe" "%V"' />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Trellis">
          <RegistryValue Type="string" Value="Open in Trellis" />
          <RegistryValue Name="Icon" Type="string" Value="[INSTALLFOLDER]trellis.exe,0" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe" "%V"' />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="folders" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- trellis:// links, as url_scheme::windows registers them. -->
      <Component Id="LinkScheme" Condition="LINKSCHEME = 1">
        <RegistryKey Root="HKCU" Key="Software\Classes\trellis">
          <RegistryValue Type="string" Value="URL:Trellis link" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe",0' />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value='"[INSTALLFOLDER]trellis.exe" "%1"' />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="links" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="TrellisShortcut" Name="Trellis" Description="A Git client" Target="[INSTALLFOLDER]trellis.exe" WorkingDirectory="INSTALLFOLDER" Icon="TrellisIcon" />
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOPSHORTCUT = 1">
        <Shortcut Id="TrellisDesktopShortcut" Name="Trellis" Description="A Git client" Target="[INSTALLFOLDER]trellis.exe" WorkingDirectory="INSTALLFOLDER" Icon="TrellisIcon" />
        <RegistryValue Root="HKCU" Key="Software\Trellis\Installer" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Trellis" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- The pages. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\installer\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\installer\dialog.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Trellis" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#TrellisExeFile]" />
    <CustomAction Id="LaunchTrellis" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <!-- The page order and the Options page: pages.wxs. -->
    <UIRef Id="TrellisPages" />
  </Package>
</Wix>
